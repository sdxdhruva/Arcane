<?xml version="1.0" encoding="utf-8"?>
<!-- 108x108dp canvas for adaptive icon foreground: Arcane Cyber-Shield Emblem -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Outer shield plate -->
    <path
        android:pathData="M54,20 L80,31 L80,58 C80,75 54,90 54,90 C54,90 28,75 28,58 L28,31 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="28"
                android:startY="20"
                android:endX="80"
                android:endY="90"
                android:startColor="#2B264A"
                android:endColor="#141424" />
        </aapt:attr>
    </path>

    <!-- Outer bevel hairline -->
    <path
        android:pathData="M54,20 L80,31 L80,58 C80,75 54,90 54,90 C54,90 28,75 28,58 L28,31 Z"
        android:strokeColor="#5E4DB2"
        android:strokeWidth="1.5" />

    <!-- Inner glowing violet shield border -->
    <path
        android:pathData="M54,26 L74,35 L74,56 C74,70 54,82 54,82 C54,82 34,70 34,56 L34,35 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="35"
                android:startColor="#352668"
                android:endColor="#0E0F1A" />
        </aapt:attr>
    </path>

    <path
        android:pathData="M54,26 L74,35 L74,56 C74,70 54,82 54,82 C54,82 34,70 34,56 L34,35 Z"
        android:strokeColor="#9C82FF"
        android:strokeWidth="1.8" />

    <!-- A chevron / key wings -->
    <path
        android:pathData="M43,68 L54,35 L65,68"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Keyhole aperture circle -->
    <path
        android:pathData="M54,49 A4.5,4.5 0 1,0 54,58 A4.5,4.5 0 1,0 54,49 Z"
        android:fillColor="#9C82FF" />

    <!-- Horizontal cross-bar -->
    <path
        android:pathData="M46,61 L62,61"
        android:strokeColor="#5FD3E8"
        android:strokeWidth="2.8"
        android:strokeLineCap="round" />
</vector>
